#!/usr/bin/env bash
# Z.OS client. No parsing, ever — the daemon's agent decides what the text means.
set -euo pipefail

if [ "$#" -gt 0 ]; then
  text="$*"
else
  # Super+Space has two owners (GNOME's binding and the daemon's own listener), so this
  # can be launched twice for one press. Hold a lock for as long as the box is up and let
  # the second one lose: the daemon tests this same lock before firing. The lock is on the
  # fd, not the file, so it is released even if this is killed and a stale file is
  # meaningless. Detecting the client by scanning /proc instead was wrong three times over
  # — a shell merely naming the path counted as a client, and argv[0] is the interpreter
  # for a script, not the script.
  # Failing to lock must never suppress the box. GNOME discards this script's stderr, so
  # an exit before zenity is indistinguishable from "the hotkey does not work" — the exact
  # silent failure the lock exists to prevent. Only *winning* the lock and losing the race
  # may exit; a missing flock or an unopenable path falls through and shows the box.
  LOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/zos-client.lock"
  if command -v flock >/dev/null 2>&1 && { exec 9>"$LOCK"; } 2>/dev/null; then
    flock -n 9 || exit 0
  fi
  text="$(zenity --entry --title="Z.OS" --text="" 2>/dev/null || true)"
  # The lock means "a box is up", nothing more. Held any longer, an fd inherited by the
  # socat below could keep the hotkey dead after the box is gone.
  exec 9>&-
fi
[ -n "$text" ] || exit 0

# GNOME spawns this from the hotkey and discards its stderr, so a failure here is
# invisible: the entry box appears, the text goes nowhere, and nothing says why. Worse,
# set -u aborts silently at "$XDG_RUNTIME_DIR" if the spawner did not export it. Default
# the path rather than trusting the inherited environment, and report what breaks.
SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/zos.sock"

if ! python3 -c 'import json,sys; sys.stdout.write(json.dumps({"source":"user","text":sys.argv[1]}))' "$text" \
     | socat - "UNIX-CONNECT:$SOCK" 2>/dev/null; then
  notify-send -u critical "Z.OS" "could not reach the daemon at $SOCK"
  exit 1
fi
